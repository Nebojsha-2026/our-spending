# Copy to .env.local for local dev, and add the same two vars in Vercel → Settings → Environment Variables.
# Supabase → Project Settings → API (Data API URL) and API Keys (publishable key).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Older projects can use the legacy anon key instead:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Optional: budget alerts locally (npx web-push generate-vapid-keys). Deploys with a
# database URL create their own keys; see docs/budget-alerts.md.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
